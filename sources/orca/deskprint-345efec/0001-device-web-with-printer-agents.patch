+namespace {
+// Moonraker consumes plain G-code, never the 3MF container used by Bambu jobs.
+// Own only a randomly created temporary directory; never extract archive paths.
+struct MoonrakerGcodeUpload {
+    boost::filesystem::path path, temporary_dir;
+    boost::filesystem::path original_filename;
+    bool valid = false;
+    std::string error;
+    void configure_timelapse(bool enabled) {
+        namespace fs = boost::filesystem;
+        if (temporary_dir.empty()) {
+            temporary_dir = fs::temp_directory_path() / fs::unique_path("deskprinter-gcode-%%%%-%%%%-%%%%");
+            if (!fs::create_directory(temporary_dir)) { valid = false; return; }
+        }
+        const fs::path target = temporary_dir / "prepared.gcode";
+        boost::nowide::ifstream source(path.string(), std::ios::binary);
+        boost::nowide::ofstream output(target.string(), std::ios::binary | std::ios::trunc);
+        if (!source || !output) { valid = false; return; }
+        output << "TLC_TIMELAPSE ENABLE=" << (enabled ? 1 : 0) << "\n";
+        std::vector<std::string> block;
+        size_t native_blocks = 0;
+        bool intentionally_unsupported = false;
+        auto clean = [](std::string line) {
+            const auto comment = line.find(';');
+            if (comment != std::string::npos) line.resize(comment);
+            boost::trim(line);return line;
+        };
+        auto native_block = [&]() {
+            std::vector<std::string> commands;
+            for (const auto& line : block) { auto cmd=clean(line);if (!cmd.empty())commands.push_back(cmd); }
+            return commands.size()==7 && commands[0]=="M5001 G92 E0" && commands[1]=="M5001 G17" &&
+                commands[2].rfind("M5001 G2 Z",0)==0 && commands[2].find(" I0.86 J0.86 P1 F20000")!=std::string::npos &&
+                commands[3]=="M5001 G1 X0 Y180 F24000" && commands[4]=="M5001 P15" &&
+                commands[5]=="M5001 M400 P300" && commands[6]=="M5001 G92 E0";
+        };
+        std::string line;
+        while (std::getline(source,line)) {
+            if (line.size()>1024*1024) { valid=false;return; }
+            std::string trimmed=line;boost::trim(trimmed);
+            if (trimmed=="; spiral_mode = 1" || trimmed=="; print_sequence = by object")intentionally_unsupported=true;
+            if (trimmed=="TLC_TIMELAPSE ENABLE=0" || trimmed=="TLC_TIMELAPSE ENABLE=1")continue;
+            if (!block.empty()) {
+                block.push_back(line);
+                if (block.size()>64) { valid=false;return; }
+                if (trimmed==";time lapse end") {
+                    // Only this exact, supplied stock block may be omitted.
+                    // Other custom G-code is preserved, never broadly filtered.
+                    const bool stock = native_block();
+                    if (stock) ++native_blocks;
+                    if (enabled || !stock)for (const auto& saved : block)output << saved << '\n';
+                    else output << "G92 E0\nG17\nG92 E0\n";
+                    block.clear();
+                }
+            } else if (trimmed==";time lapse begin")block.push_back(line);
+            else output << line << '\n';
+        }
+        if (!block.empty())for (const auto& saved : block)output << saved << '\n';
+        output.flush();valid=source.eof() && output.good();
+        if (enabled && native_blocks == 0 && !intentionally_unsupported) {
+            error="DeskPrinter timelapse: re-slice after integrating the Creality layer template. No capture block was generated in this file.";
+            BOOST_LOG_TRIVIAL(error) << error;
+            valid = false;
+        }
+        if (valid)path=target;
+    }
+    void configure_filaments(const PrintParams& params) {
+        MoonrakerToolMapping mapping(params.ams_mapping,params.ams_mapping2);
+        boost::nowide::ifstream scan(path.string(),std::ios::binary);
+        std::string line;
+        while (std::getline(scan,line)) {
+            if (line.size()>1024*1024)throw std::runtime_error("DeskPrinter: print line exceeds the preparation limit.");
+            mapping.inspect(line);
+        }
+        if (!scan.eof() || !mapping.has_tools())throw std::runtime_error("DeskPrinter: no validated tool selection in the print file.");
+        if (temporary_dir.empty()) {
+            temporary_dir=boost::filesystem::temp_directory_path()/boost::filesystem::unique_path("deskprinter-gcode-%%%%-%%%%-%%%%");
+            if (!boost::filesystem::create_directory(temporary_dir))throw std::runtime_error("DeskPrinter: cannot prepare the mapped print file.");
+        }
+        const auto target=temporary_dir/"mapped.gcode";
+        boost::nowide::ifstream input(path.string(),std::ios::binary);
+        boost::nowide::ofstream output(target.string(),std::ios::binary|std::ios::trunc);
+        if (!input || !output)throw std::runtime_error("DeskPrinter: cannot prepare the mapped print file.");
+        while (std::getline(input,line))output << mapping.rewrite(line) << '\n';
+        output.flush();
+        if (!input.eof() || !output.good())throw std::runtime_error("DeskPrinter: incomplete mapped print file.");
+        path=target;
+    }
+    explicit MoonrakerGcodeUpload(const PrintParams& params, bool studio_timelapse, bool studio_cfs) {
+        namespace fs = boost::filesystem;
+        try {
+            path = params.dst_file.empty() ? params.filename : params.dst_file;
+            original_filename=path.filename();
+            if (!fs::is_regular_file(path)) return;
+            char magic[4] = {};
+            boost::nowide::ifstream input(path.string(), std::ios::binary);
+            input.read(magic, sizeof(magic));
+            const bool zipped = magic[0] == 'P' && magic[1] == 'K';
+            if (!zipped) {
+                // A declared 3MF must not silently be renamed and printed.
+                valid = !boost::iends_with(path.string(), ".3mf");
+                if (valid && studio_timelapse)configure_timelapse(params.task_record_timelapse);
+                if (valid && studio_cfs && params.task_use_ams)configure_filaments(params);
+                return;
+            }
+            mz_zip_archive zip = {};
+            if (!open_zip_reader(&zip, path.string())) return;
+            struct Close { mz_zip_archive* zip; ~Close() { close_zip_reader(zip); } } close{&zip};
+            int selected = -1, count = 0;
+            const std::string requested = "Metadata/plate_" + std::to_string(params.plate_index) + ".gcode";
+            for (mz_uint i = 0; i < mz_zip_reader_get_num_files(&zip); ++i) {
+                mz_zip_archive_file_stat entry;
+                if (!mz_zip_reader_file_stat(&zip, i, &entry)) return;
+                const std::string name = entry.m_filename;
+                if (name == requested) { selected = static_cast<int>(i); break; }
+                if (params.plate_index <= 0 && boost::starts_with(name, "Metadata/plate_") && boost::ends_with(name, ".gcode")) {
+                    selected = static_cast<int>(i); ++count;
+                }
+            }
+            if (selected < 0 || (params.plate_index <= 0 && count != 1)) return;
+            mz_zip_archive_file_stat entry;
+            if (!mz_zip_reader_file_stat(&zip, selected, &entry) || entry.m_is_directory ||
+                entry.m_uncomp_size == 0 || entry.m_uncomp_size > 1024ULL*1024*1024) return;
+            temporary_dir = fs::temp_directory_path() / fs::unique_path("deskprinter-gcode-%%%%-%%%%-%%%%");
+            if (!fs::create_directory(temporary_dir)) return;
+            path = temporary_dir / "plate.gcode";
+            original_filename=path.filename();
+            if (!extract_zip_entry_to_file(&zip, selected, path)) return; // Includes archive CRC verification.
+            boost::nowide::ifstream extracted(path.string(), std::ios::binary);
+            char header[4] = {}; extracted.read(header, sizeof(header));
+            valid = extracted.gcount() > 0 && !(header[0] == 'P' && header[1] == 'K');
+            extracted.close();
+            if (valid && studio_timelapse)configure_timelapse(params.task_record_timelapse);
+            if (valid && studio_cfs && params.task_use_ams)configure_filaments(params);
+        } catch (const std::exception& failure) {
+            valid=false;error=failure.what();
+            BOOST_LOG_TRIVIAL(error) << "Moonraker G-code preparation failed: " << error;
+        }
+    }
+    MoonrakerGcodeUpload(const MoonrakerGcodeUpload&) = delete;
+    ~MoonrakerGcodeUpload() {
+        if (!temporary_dir.empty()) {
+            boost::system::error_code ignored;
+            boost::filesystem::remove(temporary_dir / "plate.gcode", ignored);
+            boost::filesystem::remove(temporary_dir / "prepared.gcode", ignored);
+            boost::filesystem::remove(temporary_dir / "mapped.gcode", ignored);
+            boost::filesystem::remove(temporary_dir, ignored);
+        }
+    }
+};
+}
